        "dsp_reverb_decay": 0.30
    },
    "network": {
        "host": "0.0.0.0",
        "port": 8765,
        "ws_port": 8765,
        "require_auth": true,
        "token_file": "Configuration/auth_token.json",
        "heartbeat_interval": 10
