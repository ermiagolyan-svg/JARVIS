        "host": "127.0.0.1",
        "port": 8080,
        "base_url": "http://127.0.0.1:8080/v1",
        "health_url": "http://127.0.0.1:8080/health",
        "n_gpu_layers": 99,
        "context_length": 8192,
        "cpu_threads": 8,
        "flash_attn": true,
        "kv_cache_type": "q8_0",
