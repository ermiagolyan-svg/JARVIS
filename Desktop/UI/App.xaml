<Application x:Class="JarvisDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Core Holographic Colors -->
        <Color x:Key="BgDeepNavyColor">#050B14</Color>
        <Color x:Key="BgPanelColor">#091426</Color>
        <Color x:Key="BgCardColor">#0D1F38</Color>
        <Color x:Key="CyanPrimaryColor">#00E5FF</Color>
        <Color x:Key="CyanSecondaryColor">#0088CC</Color>
        <Color x:Key="AlertRedColor">#FF3366</Color>
        <Color x:Key="ActiveGreenColor">#00FFAA</Color>
        <Color x:Key="WarningAmberColor">#FFB300</Color>
        <Color x:Key="TextPrimaryColor">#E6F9FF</Color>
        <Color x:Key="TextMutedColor">#6C99B8</Color>

        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="BgDeepNavyBrush" Color="{StaticResource BgDeepNavyColor}"/>
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
        <SolidColorBrush x:Key="CyanPrimaryBrush" Color="{StaticResource CyanPrimaryColor}"/>
        <SolidColorBrush x:Key="CyanSecondaryBrush" Color="{StaticResource CyanSecondaryColor}"/>
        <SolidColorBrush x:Key="AlertRedBrush" Color="{StaticResource AlertRedColor}"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="{StaticResource ActiveGreenColor}"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="CyanBorderDimBrush" Color="#3300E5FF"/>

        <!-- Holographic Button Style -->
        <Style x:Key="HoloButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1400E5FF"/>
            <Setter Property="Foreground" Value="{StaticResource CyanPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3300E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5500E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="HoloDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource HoloButtonStyle}">
            <Setter Property="Background" Value="#1AFF3366"/>
            <Setter Property="Foreground" Value="{StaticResource AlertRedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AlertRedBrush}"/>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="HoloSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource HoloButtonStyle}">
            <Setter Property="Background" Value="#1A00FFAA"/>
            <Setter Property="Foreground" Value="{StaticResource ActiveGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ActiveGreenBrush}"/>
        </Style>

        <!-- Holographic TextBox Style -->
        <Style x:Key="HoloTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#071120"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource CyanPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Holographic ProgressBar Style -->
        <Style x:Key="HoloProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#06101E"/>
            <Setter Property="Foreground" Value="{StaticResource CyanPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#3300E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="10"/>
        </Style>
    </Application.Resources>
</Application>