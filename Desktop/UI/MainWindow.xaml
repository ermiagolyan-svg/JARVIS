<Window x:Class="JarvisDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S. MARK VII TERMINAL"
        Height="940" Width="1680" MinHeight="800" MinWidth="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepNavyBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Dark Holographic TabControl & TabItem -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#071120"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="#3300E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Margin="2,0,2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A00E5FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CyanPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#06101E"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#3300E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#081528"/>
            <Setter Property="AlternatingRowBackground" Value="#0B1C34"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E00E5FF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D223F"/>
            <Setter Property="Foreground" Value="{StaticResource CyanPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#3300E5FF"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP HEADER BAR ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource CyanPrimaryBrush}" BorderThickness="1"
                CornerRadius="6" Padding="18,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- System Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock Text="J.A.R.V.I.S. MARK VII TERMINAL"
                               Foreground="{StaticResource CyanPrimaryBrush}"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="JUST A RATHER VERY INTELLIGENT SYSTEM // CORE HUD"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"/>
                </StackPanel>

                <!-- Live State Badge -->
                <Border x:Name="StateBadgeBorder" Grid.Column="1"
                        Background="#1800E5FF" BorderBrush="{StaticResource CyanPrimaryBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,5" VerticalAlignment="Center" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StateLed" Width="10" Height="10" Fill="{StaticResource CyanPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtSystemState" Text="IDLE"
                                   Foreground="{StaticResource CyanPrimaryBrush}"
                                   FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Model Status Badge -->
                <Border Grid.Column="2" Background="#071324" BorderBrush="#3300E5FF"
                        BorderThickness="1" CornerRadius="4" Padding="12,5"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AI ENGINE:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtModelStatus" Text="Qwen 3.5 9B - llama.cpp CUDA [READY]"
                                   Foreground="{StaticResource ActiveGreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Lumia 950 XL Connection Status -->
                <Border Grid.Column="3" Background="#071324" BorderBrush="#3300E5FF"
                        BorderThickness="1" CornerRadius="4" Padding="12,5"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="LumiaLed" Width="9" Height="9" Fill="{StaticResource TextMutedBrush}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtLumiaStatus" Text="LUMIA 950 XL: DISCONNECTED"
                                   Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Pairing PIN Readout -->
                <Border Grid.Column="4" Background="#071324" BorderBrush="{StaticResource CyanSecondaryBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12,5"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PAIR PIN:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtPairingPin" Text="------"
                                   Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Master Mute Toggle Button -->
                <Button x:Name="BtnMasterMute" Grid.Column="5"
                        Content="MIC ACTIVE" Width="135"
                        Style="{StaticResource HoloSuccessButtonStyle}"
                        Click="BtnMasterMute_Click"/>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN 3-COLUMN WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT PANEL: HARDWARE TELEMETRY HUD ========== -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="HARDWARE TELEMETRY"
                               Foreground="{StaticResource CyanPrimaryBrush}"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="WORKSTATION SENSOR ARRAY // REAL-TIME"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10" Margin="0,0,0,16"/>

                    <!-- CPU Card: Ryzen 7 9700X -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                            BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="CPU // AMD RYZEN 7 9700X" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtCpuPercent" Text="0.0%" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarCpuLoad" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU Card: RTX 3080 10GB -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                            BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="GPU // NVIDIA RTX 3080" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtGpuPercent" Text="0.0% | 0°C" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarGpuLoad" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="VRAM ALLOCATION" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="TxtVramUsage" Text="0 / 10240 MB" Foreground="{StaticResource ActiveGreenBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarVramUsage" Style="{StaticResource HoloProgressBarStyle}" Foreground="{StaticResource ActiveGreenBrush}" Minimum="0" Maximum="10240" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Card: 32GB DDR5 -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                            BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="SYSTEM MEMORY // DDR5-6400" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtRamUsage" Text="0.0 / 32.0 GB" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarRamUsage" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="32" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio Routing & Network Status -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                            BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AUDIO &amp; LINK ROUTING" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="Active Microphone:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtActiveMic" Text="LOCAL PC MIC" Foreground="{StaticResource ActiveGreenBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="WebSocket Stream:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtWsLink" Text="CONNECTING..." Foreground="{StaticResource WarningAmberBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Endpoint Port:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="127.0.0.1:8765" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick Controls -->
                    <TextBlock Text="DIRECT OVERRIDE CONTROLS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,8"/>
                    <Button x:Name="BtnWakeTrigger" Content="WAKE TRIGGER (HEY JARVIS)"
                            Style="{StaticResource HoloButtonStyle}" Margin="0,0,0,8"
                            Click="BtnWakeTrigger_Click"/>
                    <Button x:Name="BtnRefreshTelemetry" Content="FORCE TELEMETRY SYNC"
                            Style="{StaticResource HoloButtonStyle}"
                            Click="BtnRefreshTelemetry_Click"/>
                </StackPanel>
            </Border>

            <!-- ========== CENTER PANEL: ARC REACTOR HUD + PERSIAN CHAT ========== -->
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="295"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Center: Animated Concentric Arc Reactor & Live RMS Visualizer -->
                <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                        BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Concentric Arc Reactor Canvas -->
                        <Canvas Grid.Column="0" Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Outer Static Ring -->
                            <Ellipse Width="220" Height="220" Canvas.Left="5" Canvas.Top="5"
                                     Stroke="#2200E5FF" StrokeThickness="2"/>

                            <!-- Rotating Outer Segmented Ring -->
                            <Ellipse x:Name="RingOuter" Width="200" Height="200" Canvas.Left="15" Canvas.Top="15"
                                     Stroke="{StaticResource CyanPrimaryBrush}" StrokeThickness="4"
                                     StrokeDashArray="10 5 3 5" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="OuterRingRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Counter-Rotating Middle Ring -->
                            <Ellipse x:Name="RingMiddle" Width="156" Height="156" Canvas.Left="37" Canvas.Top="37"
                                     Stroke="{StaticResource CyanSecondaryBrush}" StrokeThickness="5"
                                     StrokeDashArray="6 4 2 4" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="MidRingRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Fast Inner Ring -->
                            <Ellipse x:Name="RingInner" Width="112" Height="112" Canvas.Left="59" Canvas.Top="59"
                                     Stroke="{StaticResource ActiveGreenBrush}" StrokeThickness="3"
                                     StrokeDashArray="4 3" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="InnerRingRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Reactor Core Glow -->
                            <Ellipse x:Name="ReactorCore" Width="68" Height="68" Canvas.Left="81" Canvas.Top="81"
                                     Fill="#3300E5FF" Stroke="{StaticResource CyanPrimaryBrush}" StrokeThickness="2"/>

                            <TextBlock x:Name="TxtReactorCenter" Text="MARK VII"
                                       Canvas.Left="86" Canvas.Top="106"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="Bold"/>
                        </Canvas>

                        <!-- Right of Reactor: Live Audio RMS Waveform & State Telemetry -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,6,0">
                            <TextBlock Text="ARC REACTOR CORE // AUDIO &amp; NEURAL FEED"
                                       Foreground="{StaticResource CyanPrimaryBrush}"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtReactorSubtitle"
                                       Text="State: IDLE | Waiting for 'Hey Jarvis' wake word or command input..."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="LIVE AUDIO RMS LEVEL" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="TxtRmsValue" Text="0.000" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarRmsLevel" Style="{StaticResource HoloProgressBarStyle}"
                                         Height="12" Minimum="0" Maximum="1.0" Value="0" Margin="0,0,0,14"/>

                            <!-- 16-Bar Dynamic Waveform Visualizer -->
                            <UniformGrid x:Name="WaveformGrid" Columns="16" Height="56" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="8" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="14" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="22" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="18" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="30" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="25" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="40" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="35" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="35" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="40" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="25" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="30" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="18" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="22" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="14" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="8" Margin="2,0" Background="#06101E" Foreground="{StaticResource CyanPrimaryBrush}" BorderThickness="0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle Center: Prominent Security Confirmation Banner (Shown when PendingConfirmations > 0) -->
                <Border x:Name="SecurityBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="#28FF3366" BorderBrush="{StaticResource AlertRedBrush}"
                        BorderThickness="2" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="⚠ SENSITIVE SECURITY ACTION REQUIRES CONFIRMATION"
                                       Foreground="{StaticResource AlertRedBrush}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtPendingActionDetails"
                                       Text="Command awaiting operator authorization..."
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnApproveAction" Grid.Column="1" Content="تایید (Approve)"
                                Style="{StaticResource HoloSuccessButtonStyle}" Width="125" Margin="10,0,8,0"
                                Click="BtnApproveAction_Click"/>
                        <Button x:Name="BtnRejectAction" Grid.Column="2" Content="رد (Reject)"
                                Style="{StaticResource HoloDangerButtonStyle}" Width="115"
                                Click="BtnRejectAction_Click"/>
                    </Grid>
                </Border>

                <!-- Bottom Center: RTL Persian Conversation History + Input Box -->
                <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                        BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="DIALOGUE STREAM // تاریخچه گفتگوی جارویس"
                                       Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtChatStatus" Text="RTL PERSIAN READY"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ListBox x:Name="LstConversation" Grid.Row="1"
                                 Background="#06101E" BorderBrush="#2600E5FF" BorderThickness="1"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FlowDirection="RightToLeft" FontSize="13" Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0B1B32" BorderBrush="#2200E5FF" BorderThickness="1"
                                            CornerRadius="5" Padding="10,7" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock Text="{Binding SenderLabel}" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Content}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtChatInput" Grid.Column="0"
                                     Style="{StaticResource HoloTextBoxStyle}"
                                     FlowDirection="RightToLeft" FontSize="13"
                                     KeyDown="TxtChatInput_KeyDown"/>
                            <Button x:Name="BtnSendChat" Grid.Column="1" Content="ارسال (SEND)"
                                    Style="{StaticResource HoloButtonStyle}" Margin="8,0,0,0"
                                    Click="BtnSendChat_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== RIGHT PANEL: STAGE 7.3 MANAGEMENT TABS ========== -->
            <TabControl Grid.Column="2">
                <!-- TAB 1: VOICE & WAKE-WORD CONFIG -->
                <TabItem Header="VOICE &amp; DSP">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="JARVIS VOICE &amp; DSP SYNTHESIS"
                                       Foreground="{StaticResource CyanPrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Adjust real-time metallic DSP filter and openWakeWord sensitivity"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,16"/>

                            <!-- Pitch Semitones -->
                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Pitch Shift (Semitones)" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblPitchVal" Text="-2.5" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SldPitch" Minimum="-6.0" Maximum="4.0" Value="-2.5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Metallic Mix -->
                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Metallic Comb Filter Mix" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblMetallicVal" Text="0.22" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SldMetallic" Minimum="0.0" Maximum="0.80" Value="0.22" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Reverb Decay -->
                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Holographic Reverb Decay" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblReverbVal" Text="0.18" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SldReverb" Minimum="0.0" Maximum="0.70" Value="0.18" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Wake-Word Threshold -->
                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Wake-Word Threshold ('Hey Jarvis')" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblWakeVal" Text="0.50" Foreground="{StaticResource ActiveGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SldWakeThreshold" Minimum="0.15" Maximum="0.90" Value="0.50" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnApplyVoiceConfig" Content="APPLY VOICE &amp; DSP CONFIGURATION"
                                    Style="{StaticResource HoloButtonStyle}" Margin="0,0,0,10"
                                    Click="BtnApplyVoiceConfig_Click"/>
                            <Button x:Name="BtnTestVoice" Content="TEST PERSIAN TTS SYNTHESIS"
                                    Style="{StaticResource HoloSuccessButtonStyle}"
                                    Click="BtnTestVoice_Click"/>
                            <TextBlock x:Name="TxtVoiceConfigResult" Text=""
                                       Foreground="{StaticResource ActiveGreenBrush}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: MEMORY MANAGEMENT -->
                <TabItem Header="MEMORY &amp; FACTS">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="LONG-TERM USER FACTS (SQLite)"
                                       Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="REFRESH" Style="{StaticResource HoloButtonStyle}"
                                    HorizontalAlignment="Right" Padding="10,4" Click="BtnRefreshFacts_Click"/>
                        </DockPanel>

                        <DataGrid x:Name="GridFacts" Grid.Row="1" AutoGenerateColumns="False" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="42"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="75"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="105"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                <DataGridTextColumn Header="Imp" Binding="{Binding Importance}" Width="42"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add Fact Form -->
                        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ADD / UPDATE USER FACT" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtFactCategory" Grid.Column="0" Style="{StaticResource HoloTextBoxStyle}" Text="user" ToolTip="Category" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtFactKey" Grid.Column="1" Style="{StaticResource HoloTextBoxStyle}" Text="" ToolTip="Fact Key (e.g. profession)" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtFactImportance" Grid.Column="2" Style="{StaticResource HoloTextBoxStyle}" Text="5" ToolTip="Importance (1-10)"/>
                                </Grid>
                                <TextBox x:Name="TxtFactValue" Style="{StaticResource HoloTextBoxStyle}" FlowDirection="RightToLeft" Margin="0,0,0,8" ToolTip="Fact Value"/>
                                <Button Content="SAVE FACT TO MEMORY" Style="{StaticResource HoloSuccessButtonStyle}" Click="BtnAddFact_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Delete Fact / Clear History Buttons -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="DELETE SELECTED FACT"
                                    Style="{StaticResource HoloDangerButtonStyle}" Margin="0,0,5,0"
                                    Click="BtnDeleteFact_Click"/>
                            <Button Grid.Column="1" Content="CLEAR CHAT HISTORY"
                                    Style="{StaticResource HoloDangerButtonStyle}" Margin="5,0,0,0"
                                    Click="BtnClearHistory_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: SECURITY & STARTUP -->
                <TabItem Header="SECURITY &amp; STARTUP">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Windows Startup Toggle Card -->
                        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                                BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="WINDOWS INTERACTIVE LOGON STARTUP" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock x:Name="TxtStartupState" Text="Checking HKCU Run registry..." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnToggleStartup" Content="ENABLE STARTUP"
                                        Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Width="135"
                                        Click="BtnToggleStartup_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- System Diagnostics Runner -->
                        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="#2600E5FF"
                                BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="SUBSYSTEM DIAGNOSTICS RUNNER" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="RUN DIAGNOSTICS" Style="{StaticResource HoloSuccessButtonStyle}"
                                            HorizontalAlignment="Right" Padding="10,4" Click="BtnRunDiagnostics_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtDiagnosticsOutput"
                                           Text="Click 'RUN DIAGNOSTICS' to verify REST API, WebSocket, LLM &amp; Telemetry health."
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <TextBlock Text="4-TIER SECURITY AUDIT LOG" Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <Button Content="REFRESH AUDIT" Style="{StaticResource HoloButtonStyle}"
                                    HorizontalAlignment="Right" Padding="10,3" Click="BtnRefreshAudit_Click"/>
                        </DockPanel>

                        <DataGrid x:Name="GridSecurityAudit" Grid.Row="3" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                <DataGridTextColumn Header="Command" Binding="{Binding CommandType}" Width="115"/>
                                <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 4: LIVE LOG VIEWER -->
                <TabItem Header="LIVE LOGS">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="SEVERITY:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbLogSeverity" Width="115" SelectedIndex="0" SelectionChanged="CmbLogSeverity_SelectionChanged">
                                <ComboBoxItem Content="ALL"/>
                                <ComboBoxItem Content="INFO"/>
                                <ComboBoxItem Content="WARNING"/>
                                <ComboBoxItem Content="ERROR"/>
                            </ComboBox>
                            <Button Content="REFRESH LOGS" Style="{StaticResource HoloButtonStyle}"
                                    HorizontalAlignment="Right" Padding="10,4" Click="BtnRefreshLogs_Click"/>
                        </DockPanel>

                        <ListBox x:Name="LstLogs" Grid.Row="1"
                                 Background="#050D1A" BorderBrush="#3300E5FF" BorderThickness="1"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ==================== 3. BOTTOM STATUS TICKER ==================== -->
        <Border Grid.Row="2" Background="#071222" BorderBrush="#2600E5FF" BorderThickness="1"
                CornerRadius="4" Padding="12,4" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtStatusBar"
                           Text="J.A.R.V.I.S. Mark VII Desktop HUD Initialized | Waiting for backend stream on 127.0.0.1:8765..."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtClock" Text="00:00:00"
                           Foreground="{StaticResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>