<Window x:Class="JarvisDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="C.E.L.E.S.T.E. // CYBERNETIC ENGINE FOR LOGIC, ENGINEERING &amp; STRATEGIC TACTICAL EXECUTION"
        Height="920" Width="1640" MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDeepNavyBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        KeyDown="MainWindow_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Pill TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,6,6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BtnDefaultBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource CyanSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBoxItem -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Cyber DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridRowBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CyanPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="cellBd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cellBd" Property="Background" Value="{DynamicResource BtnDefaultBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Frame Border -->
    <Border x:Name="OuterFrameBorder" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1">
        <Grid ClipToBounds="True">
            <!-- ==================== LAYER 0: FULL-SCREEN CELESTE COSMIC STAR SPHERE ==================== -->
            <Grid Background="{DynamicResource BackdropRadialBrush}" MouseDown="CosmicBackdrop_MouseDown">
                <!-- Subtle Ambient Radial Halo (Hidden in LCD Light Mode for 100% pure white transparency) -->
                <Ellipse x:Name="AmbientHalo" Width="680" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="HaloInnerStop" Color="#2838BDF8" Offset="0.0"/>
                            <GradientStop Color="#0C00F0FF" Offset="0.50"/>
                            <GradientStop Color="#0005070B" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Dynamic 3D Star Sphere (740 Stars), Orbital Rings & Listening Wave Canvas -->
                <Canvas x:Name="CosmicSphereCanvas" Width="820" Height="820"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <!-- Bottom Center Holographic Identity Caption -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,68" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtCenterStateTitle" Text="C  ·  E  ·  L  ·  E  ·  S  ·  T  ·  E"
                               Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" Opacity="0.95"/>
                    <TextBlock x:Name="TxtReactorSubtitle"
                               Text="CYBERNETIC ENGINE ONLINE"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ==================== LAYER 1: FLOATING GLASS TOP HUD BAR ==================== -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="20,14,20,0"
                    Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="18,10" Effect="{StaticResource PanelShadowEffect}"
                    MouseLeftButtonDown="TopHudBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Width="4" Height="28" Background="{DynamicResource CyanGradientBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="C.E.L.E.S.T.E. COMMAND CORE" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14.5" FontWeight="Bold"/>
                            <TextBlock Text="CYBER-ICE TACTICAL HUD // WORKSTATION NODE" Foreground="{DynamicResource CyanPrimaryBrush}" FontSize="9.5" FontWeight="SemiBold" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Pill State Badge -->
                    <Border x:Name="StateBadgeBorder" Grid.Column="1" Background="{DynamicResource BtnDefaultBgBrush}" BorderBrush="{DynamicResource CyanPrimaryBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14,5" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateLed" Width="8" Height="8" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtSystemState" Text="IDLE" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <!-- AI Engine Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
                            <TextBlock x:Name="TxtModelStatus" Text="Qwen 3.5 9B // CUDA ONLINE"
                                       Foreground="{DynamicResource CyanSecondaryBrush}" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Lumia 950 XL Link Pill -->
                    <Border Grid.Column="3" Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LumiaLed" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtLumiaStatus" Text="LUMIA: STANDBY" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Pairing PIN Pill -->
                    <Border Grid.Column="4" Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PIN" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPairingPin" Text="------" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Switcher Button (Theme 1 Dark vs Theme 2 Transparent LCD White) -->
                    <Button x:Name="BtnThemeSwitch" Grid.Column="5" Content="☀ LCD THEME" Width="116"
                            Style="{StaticResource HoloButtonStyle}" Click="BtnThemeSwitch_Click" Margin="0,0,8,0"
                            ToolTip="Switch between Dark Cyber-Ice and High-Contrast Transparent LCD White Mode (F10)"/>

                    <!-- Mute Button -->
                    <Button x:Name="BtnMasterMute" Grid.Column="6" Content="MIC ACTIVE" Width="114"
                            Style="{StaticResource HoloSuccessButtonStyle}" Click="BtnMasterMute_Click" Margin="0,0,12,0"/>

                    <!-- Custom Window Chrome Buttons (FullScreen + Min + Max + Close) -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnFullScreen" Content="⛶" Style="{StaticResource WindowControlButtonStyle}" Click="BtnFullScreen_Click" ToolTip="Full Screen (F11)" Margin="0,0,2,0"/>
                        <Button Content="─" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="BtnMaximize" Content="☐" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMaximize_Click" Margin="2,0" ToolTip="Maximize / Restore"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== LAYER 2: SECURITY CONFIRMATION OVERLAY BANNER ==================== -->
            <Border x:Name="SecurityBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Width="760" Margin="0,84,0,0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource AlertRedBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="18,14" Effect="{StaticResource CrimsonGlowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="⚠ TACTICAL SECURITY AUTHORIZATION REQUIRED" Foreground="{DynamicResource AlertRedBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="TxtPendingActionDetails" Text="Awaiting confirmation..."
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="تایید (Approve)" Style="{StaticResource HoloSuccessButtonStyle}" Width="125" Margin="14,0,8,0" Click="BtnApproveAction_Click"/>
                    <Button Grid.Column="2" Content="رد (Reject)" Style="{StaticResource HoloDangerButtonStyle}" Width="115" Click="BtnRejectAction_Click"/>
                </Grid>
            </Border>

            <!-- ==================== LAYER 3: SLIDE-OUT GLASS DRAWERS & DOCK HANDLES ==================== -->

            <!-- 3A. LEFT SLIDE-OUT DRAWER: SYSTEM TELEMETRY -->
            <Border x:Name="LeftDrawer" Width="370" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="20,82,0,58" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="20" Effect="{StaticResource PanelShadowEffect}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LeftDrawerTransform" X="-410"/>
                </Border.RenderTransform>
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="HARDWARE TELEMETRY" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" HorizontalAlignment="Right" Click="BtnToggleLeftDrawer_Click"/>
                    </DockPanel>

                    <!-- CPU Card -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="CPU // RYZEN 7 9700X" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtCpuPercent" Text="0.0%" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarCpuLoad" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU Card -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="GPU // RTX 3080 10GB" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtGpuPercent" Text="0.0% | 0°C" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarGpuLoad" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="VRAM MATRIX" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtVramUsage" Text="0 / 10240 MB" Foreground="{DynamicResource CyanPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarVramUsage" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="10240" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Card -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="MEMORY // 32GB DDR5-6400" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtRamUsage" Text="0.0 / 32.0 GB" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BarRamUsage" Style="{StaticResource HoloProgressBarStyle}" Minimum="0" Maximum="32" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio & Link Routing Card -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Active Audio Feed" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                <TextBlock x:Name="TxtActiveMic" Text="LOCAL PC MIC" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Vocal Energy (RMS)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                <TextBlock x:Name="TxtRmsValue" Text="0.000" Foreground="{DynamicResource CyanPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Neural WebSocket" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                <TextBlock x:Name="TxtWsLink" Text="CONNECTING..." Foreground="{DynamicResource WarningAmberBrush}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="⚡  WAKE TRIGGER (CELESTE)" Style="{StaticResource HoloSuccessButtonStyle}" Margin="0,0,0,8" Click="BtnWakeTrigger_Click"/>
                    <Button Content="↻  SYNC TELEMETRY SENSORS" Style="{StaticResource HoloButtonStyle}" Click="BtnRefreshTelemetry_Click"/>
                </StackPanel>
            </Border>

            <!-- Left Edge Floating Pill Handle -->
            <Button x:Name="BtnLeftHandle" Content="❯   TELEMETRY" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="20,0,0,0" Style="{StaticResource HoloButtonStyle}" Padding="14,12"
                    Click="BtnToggleLeftDrawer_Click"/>

            <!-- 3B. RIGHT SLIDE-OUT DRAWER: 4 MANAGEMENT TABS -->
            <Border x:Name="RightDrawer" Width="500" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,82,20,58" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18" Effect="{StaticResource PanelShadowEffect}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RightDrawerTransform" X="540"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="C.E.L.E.S.T.E. CONTROL DECK" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" HorizontalAlignment="Right" Click="BtnToggleRightDrawer_Click"/>
                    </DockPanel>

                    <TabControl Grid.Row="1">
                        <!-- TAB 1: CYBER-ICE VOCAL DSP -->
                        <TabItem Header="VOCAL DSP">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,4">
                                <StackPanel>
                                    <TextBlock Text="CYBER-ICE VOCAL CHAIN (DSP)" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Rate 1.06x  •  HPF 95Hz  •  +2.5dB @ 3.5kHz  •  Studio Reverb"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Pitch Shift (Semitones)" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock x:Name="LblPitchVal" Text="-0.3" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Slider x:Name="SldPitch" Minimum="-4.0" Maximum="2.0" Value="-0.3" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Crystal Presence &amp; Air Mix" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock x:Name="LblMetallicVal" Text="0.10" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Slider x:Name="SldMetallic" Minimum="0.0" Maximum="0.50" Value="0.10" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Tight Studio Room Reverb (8%-12%)" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock x:Name="LblReverbVal" Text="0.10" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Slider x:Name="SldReverb" Minimum="0.0" Maximum="0.50" Value="0.10" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Wake-Word Sensitivity" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock x:Name="LblWakeVal" Text="0.50" Foreground="{DynamicResource CyanPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Slider x:Name="SldWakeThreshold" Minimum="0.15" Maximum="0.90" Value="0.50" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="VoiceSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="APPLY CYBER-ICE VOCAL PROFILE" Style="{StaticResource HoloButtonStyle}" Margin="0,0,0,8" Click="BtnApplyVoiceConfig_Click"/>
                                    <Button Content="🔊  TEST CELESTE VOICE SYNTHESIS" Style="{StaticResource HoloSuccessButtonStyle}" Click="BtnTestVoice_Click"/>
                                    <TextBlock x:Name="TxtVoiceConfigResult" Text="" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="11.5" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: MEMORY & FACTS -->
                        <TabItem Header="MEMORY">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="PERSISTENT FACTS MATRIX (SQLite)" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="↻ REFRESH" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Padding="12,4" Click="BtnRefreshFacts_Click"/>
                                </DockPanel>

                                <DataGrid x:Name="GridFacts" Grid.Row="1" AutoGenerateColumns="False" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="42"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="75"/>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="105"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTextColumn Header="Imp" Binding="{Binding Importance}" Width="45"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtFactCategory" Grid.Column="0" Style="{StaticResource HoloTextBoxStyle}" Text="user" Margin="0,0,6,0" ToolTip="Category"/>
                                            <TextBox x:Name="TxtFactKey" Grid.Column="1" Style="{StaticResource HoloTextBoxStyle}" Text="" Margin="0,0,6,0" ToolTip="Fact Key"/>
                                            <TextBox x:Name="TxtFactImportance" Grid.Column="2" Style="{StaticResource HoloTextBoxStyle}" Text="5" ToolTip="Importance (1-10)"/>
                                        </Grid>
                                        <TextBox x:Name="TxtFactValue" Style="{StaticResource HoloTextBoxStyle}" FlowDirection="RightToLeft" Margin="0,0,0,8" ToolTip="Fact Value"/>
                                        <Button Content="＋  SAVE FACT TO MEMORY" Style="{StaticResource HoloSuccessButtonStyle}" Click="BtnAddFact_Click"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="DELETE FACT" Style="{StaticResource HoloDangerButtonStyle}" Margin="0,0,5,0" Click="BtnDeleteFact_Click"/>
                                    <Button Grid.Column="1" Content="CLEAR HISTORY" Style="{StaticResource HoloDangerButtonStyle}" Margin="5,0,0,0" Click="BtnClearHistory_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: SECURITY & STARTUP -->
                        <TabItem Header="SECURITY">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WINDOWS LOGON AUTO-START" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="TxtStartupState" Text="Checking registry..." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleStartup" Content="ENABLE" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Width="115" Click="BtnToggleStartup_Click"/>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="SUBSYSTEM DIAGNOSTICS" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="RUN CHECK" Style="{StaticResource HoloSuccessButtonStyle}" HorizontalAlignment="Right" Padding="12,4" Click="BtnRunDiagnostics_Click"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtDiagnosticsOutput" Text="Ready to verify C.E.L.E.S.T.E. subsystems." Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                    <TextBlock Text="SECURITY AUDIT LOG" Foreground="{DynamicResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="↻ REFRESH" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Padding="12,4" Click="BtnRefreshAudit_Click"/>
                                </DockPanel>

                                <DataGrid x:Name="GridSecurityAudit" Grid.Row="3" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                        <DataGridTextColumn Header="Command" Binding="{Binding CommandType}" Width="115"/>
                                        <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="75"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: LIVE LOGS -->
                        <TabItem Header="LOGS">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <ComboBox x:Name="CmbLogSeverity" Width="125" SelectedIndex="0" SelectionChanged="CmbLogSeverity_SelectionChanged">
                                        <ComboBoxItem Content="ALL"/>
                                        <ComboBoxItem Content="INFO"/>
                                        <ComboBoxItem Content="WARNING"/>
                                        <ComboBoxItem Content="ERROR"/>
                                    </ComboBox>
                                    <Button Content="↻ REFRESH LOGS" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Padding="12,5" Click="BtnRefreshLogs_Click"/>
                                </DockPanel>
                                <Border Grid.Row="1" Background="{DynamicResource GridBgBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                                    <ListBox x:Name="LstLogs" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11"/>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Right Edge Floating Pill Handle -->
            <Button x:Name="BtnRightHandle" Content="CONTROL DECK   ❮" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,20,0" Style="{StaticResource HoloButtonStyle}" Padding="14,12"
                    Click="BtnToggleRightDrawer_Click"/>

            <!-- 3C. BOTTOM SLIDE-OUT DRAWER: PERSIAN DIALOGUE & COMMAND INPUT -->
            <Border x:Name="BottomDrawer" Height="370" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Width="1040" Margin="0,0,0,14" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="20,16" Effect="{StaticResource PanelShadowEffect}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BottomDrawerTransform" Y="400"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="C.E.L.E.S.T.E. DIALOGUE STREAM  //  ترمینال گفتگوی تاکتیکی"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChatStatus" Text="ONLINE" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                            <Button Content="▼  HIDE" Style="{StaticResource HoloButtonStyle}" Padding="12,4" Click="BtnToggleBottomDrawer_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource GridBgBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                        <ListBox x:Name="LstConversation" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" FlowDirection="RightToLeft" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CyanPrimaryBrush}" BorderThickness="0,0,3,0" CornerRadius="10" Padding="14,9" Margin="2,0,2,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SenderLabel}" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                                                <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Content}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13.5" LineHeight="21"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtChatInput" Grid.Column="0" Style="{StaticResource HoloTextBoxStyle}"
                                 FlowDirection="RightToLeft" FontSize="13.5" KeyDown="TxtChatInput_KeyDown"/>
                        <Button Grid.Column="1" Content="ارسال فرمان  ➤" Style="{StaticResource HoloSuccessButtonStyle}" Margin="10,0,0,0" Click="BtnSendChat_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom Edge Floating Dock + Status Ticker -->
            <Grid x:Name="BottomDockBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="24,0,24,16" IsHitTestVisible="True">
                <Border Background="{DynamicResource BgDockPillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusBar" Text="C.E.L.E.S.T.E. Cyber-Ice Core Initialized"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <Button x:Name="BtnBottomHandle" Content="▲   DIALOGUE &amp; COMMAND TERMINAL"
                        HorizontalAlignment="Center" Style="{StaticResource HoloButtonStyle}" Padding="24,8"
                        Click="BtnToggleBottomDrawer_Click"/>

                <Border Background="{DynamicResource BgDockPillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtClock" Text="00:00:00" Foreground="{DynamicResource CyanSecondaryBrush}"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="12.5"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>