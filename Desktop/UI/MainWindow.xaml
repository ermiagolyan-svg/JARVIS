<Window x:Class="JarvisDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:JarvisDesktop.Controls"
        Title="C.E.L.E.S.T.E. // CYBERNETIC ENGINE FOR LOGIC, ENGINEERING &amp; STRATEGIC TACTICAL EXECUTION"
        Height="920" Width="1640" MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDeepNavyBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        KeyDown="MainWindow_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Pill TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,5,6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BtnDefaultBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource CyanSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBoxItem -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Cyber DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridRowBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CyanPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="cellBd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cellBd" Property="Background" Value="{DynamicResource BtnDefaultBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CyanSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Frame Border -->
    <Border x:Name="OuterFrameBorder" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1">
        <Grid ClipToBounds="True">
            <!-- ==================== LAYER 0: FULL-SCREEN CELESTE COSMIC STAR SPHERE ==================== -->
            <Grid Background="{DynamicResource BackdropRadialBrush}" MouseDown="CosmicBackdrop_MouseDown">
                <!-- Subtle Ambient Radial Halo -->
                <Ellipse x:Name="AmbientHalo" Width="680" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="HaloInnerStop" Color="#2838BDF8" Offset="0.0"/>
                            <GradientStop Color="#0C00F0FF" Offset="0.50"/>
                            <GradientStop Color="#0005070B" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- High-Performance Direct DrawingContext 3D Star Sphere (740 Stars + Crimson Accents) -->
                <controls:CosmicSphereHost x:Name="CosmicSphere" Width="820" Height="820"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <!-- Bottom Center Holographic Identity Caption -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,68" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtCenterStateTitle" Text="C  ·  E  ·  L  ·  E  ·  S  ·  T  ·  E"
                               Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" Opacity="0.95"/>
                    <TextBlock x:Name="TxtReactorSubtitle"
                               Text="CYBERNETIC ENGINE ONLINE"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ==================== LAYER 1: FLOATING GLASS TOP HUD BAR ==================== -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="20,14,20,0"
                    Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="18,10"
                    MouseLeftButtonDown="TopHudBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Width="4" Height="28" Background="{DynamicResource CyanGradientBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="C.E.L.E.S.T.E. COMMAND CORE" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14.5" FontWeight="Bold"/>
                            <TextBlock Text="CYBER-ICE TACTICAL HUD // WORKSTATION NODE" Foreground="{DynamicResource CyanPrimaryBrush}" FontSize="9.5" FontWeight="SemiBold" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Pill State Badge -->
                    <Border x:Name="StateBadgeBorder" Grid.Column="1" Background="{DynamicResource BtnDefaultBgBrush}" BorderBrush="{DynamicResource CyanPrimaryBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14,5" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateLed" Width="8" Height="8" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtSystemState" Text="IDLE" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <!-- AI Engine Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
                            <TextBlock x:Name="TxtModelStatus" Text="Gemma-4 26B-A4B // HYBRID ONLINE"
                                       Foreground="{DynamicResource CyanSecondaryBrush}" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Lumia 950 XL Link Pill -->
                    <Border Grid.Column="3" Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LumiaLed" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtLumiaStatus" Text="LUMIA: STANDBY" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Pairing PIN Pill -->
                    <Border Grid.Column="4" Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PIN" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPairingPin" Text="------" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Switcher Button -->
                    <Button x:Name="BtnThemeSwitch" Grid.Column="5" Content="☀ LCD THEME" Width="116"
                            Style="{StaticResource HoloButtonStyle}" Click="BtnThemeSwitch_Click" Margin="0,0,8,0"
                            ToolTip="Switch between Dark Cyber-Ice and High-Contrast Transparent LCD White Mode (F10)"/>

                    <!-- Mute Button -->
                    <Button x:Name="BtnMasterMute" Grid.Column="6" Content="MIC ACTIVE" Width="114"
                            Style="{StaticResource HoloSuccessButtonStyle}" Click="BtnMasterMute_Click" Margin="0,0,12,0"/>

                    <!-- Custom Window Chrome Buttons -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnFullScreen" Content="⛶" Style="{StaticResource WindowControlButtonStyle}" Click="BtnFullScreen_Click" ToolTip="Full Screen (F11)" Margin="0,0,2,0"/>
                        <Button Content="─" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="BtnMaximize" Content="☐" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMaximize_Click" Margin="2,0" ToolTip="Maximize / Restore"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== LAYER 2: SECURITY CONFIRMATION OVERLAY BANNER ==================== -->
            <Border x:Name="SecurityBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Width="760" Margin="0,84,0,0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource AlertRedBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="18,14" Effect="{StaticResource CrimsonGlowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="⚠ TACTICAL SECURITY AUTHORIZATION REQUIRED" Foreground="{DynamicResource AlertRedBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="TxtPendingActionDetails" Text="Awaiting confirmation..."
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="تایید (Approve)" Style="{StaticResource HoloSuccessButtonStyle}" Width="125" Margin="14,0,8,0" Click="BtnApproveAction_Click"/>
                    <Button Grid.Column="2" Content="رد (Reject)" Style="{StaticResource HoloDangerButtonStyle}" Width="115" Click="BtnRejectAction_Click"/>
                </Grid>
            </Border>

            <!-- ==================== LAYER 3: SLIDE-OUT GLASS DRAWERS & DOCK HANDLES ==================== -->

            <!-- 3A. LEFT SLIDE-OUT DRAWER: SYSTEM TELEMETRY -->
            <Border x:Name="LeftDrawer" Visibility="Collapsed" Width="400" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="20,82,0,58" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="20">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LeftDrawerTransform" X="-440"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="HARDWARE TELEMETRY" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15.5" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="&#x2715;" Style="{StaticResource WindowControlButtonStyle}" HorizontalAlignment="Right" Click="BtnToggleLeftDrawer_Click"/>
                    </DockPanel>

                    <!-- Scrollable Telemetry Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <StackPanel>
                            <!-- CPU Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,15" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="CPU // RYZEN 7 9700X" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtCpuPercent" Text="0.0%" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarCpuLoad" Style="{StaticResource HoloProgressBarStyle}" Height="10" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU & VRAM Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,15" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="GPU // RTX 3080 10GB" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtGpuPercent" Text="0.0% | 0&#x00B0;C" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="15.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarGpuLoad" Style="{StaticResource HoloProgressBarStyle}" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,14"/>

                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="VRAM MATRIX" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVramUsage" Text="0 / 10240 MB" Foreground="{DynamicResource CyanPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarVramUsage" Style="{StaticResource HoloProgressBarStyle}" Height="10" Minimum="0" Maximum="10240" Value="0"/>
                                </StackPanel>
                            </Border>

                            <!-- THERMAL SENSORS CARD -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,15" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="THERMAL MATRIX" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="8" Padding="9,3" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtThermalStatus" Text="OPTIMAL" Foreground="{DynamicResource ActiveGreenBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5"/>
                                        </Border>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="GPU CORE TEMP" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtGpuTempBig" Text="0&#x00B0;C" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="20" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtSecondTempLabel" Text="THROTTLE HEADROOM" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtSecondTempValue" Text="--&#x00B0;C" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="20" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ProgressBar x:Name="BarGpuTemp" Style="{StaticResource HoloProgressBarStyle}" Height="10" Minimum="20" Maximum="95" Value="35"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,15" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="MEMORY // 32GB DDR5-6400" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRamUsage" Text="0.0 / 32.0 GB" Foreground="{DynamicResource CyanSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarRamUsage" Style="{StaticResource HoloProgressBarStyle}" Height="10" Minimum="0" Maximum="32" Value="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Audio & Link Routing Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,15" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Active Audio Feed" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtActiveMic" Text="LOCAL PC MIC" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Vocal Energy (RMS)" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRmsValue" Text="0.000" Foreground="{DynamicResource CyanPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Neural WebSocket" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtWsLink" Text="CONNECTING..." Foreground="{DynamicResource WarningAmberBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="&#x26A1;  WAKE TRIGGER (CELESTE)" Style="{StaticResource HoloSuccessButtonStyle}" FontSize="13" Padding="14,11" Margin="0,0,0,10" Click="BtnWakeTrigger_Click"/>
                        <Button Content="&#x21BB;  SYNC TELEMETRY SENSORS" Style="{StaticResource HoloButtonStyle}" FontSize="13" Padding="14,11" Click="BtnRefreshTelemetry_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left Edge Floating Pill Handle -->
            <Button x:Name="BtnLeftHandle" Content="❯   TELEMETRY" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="20,0,0,0" Style="{StaticResource HoloButtonStyle}" Padding="14,12"
                    Click="BtnToggleLeftDrawer_Click"/>

            <!-- 3B. RIGHT SLIDE-OUT DRAWER: 5 MANAGEMENT TABS -->
            <Border x:Name="RightDrawer" Visibility="Collapsed" Width="520" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,82,20,58" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RightDrawerTransform" X="560"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="C.E.L.E.S.T.E. CONTROL DECK" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" HorizontalAlignment="Right" Click="BtnToggleRightDrawer_Click"/>
                    </DockPanel>

                    <TabControl Grid.Row="1">
                        <!-- TAB 1: DUAL-ENGINE TTS & CYBER-ICE VOCAL DSP -->
                        <TabItem Header="VOICE &amp; TTS">
                            <ScrollViewer Padding="4,8,4,4" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" Margin="0,0,0,4" Text="DUAL-ENGINE TTS SYNTHESIS PIPELINE"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" Text="Switch between Gemini Online Cloud TTS and Gooya Bozorg v1.5 Local GPU" TextWrapping="Wrap"/>

                                    <!-- ENGINE MODE SELECTOR -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Padding="12">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Text="Active Speech Synthesis Engine"/>
                                            <ComboBox FontSize="12" FontWeight="SemiBold" Padding="8,6" SelectedIndex="0" SelectionChanged="CmbVoiceEngineMode_SelectionChanged" x:Name="CmbVoiceEngineMode">
                                                <ComboBoxItem Content="GEMINI ONLINE (Cloud Neural TTS - Zero VRAM)" Tag="gemini"/>
                                                <ComboBoxItem Content="GOOYA BOZORG v1.5 (Local RTX 3080 - Chatterbox 801M)" Tag="gooya"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL A: GEMINI ONLINE TTS SETTINGS -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Padding="12" x:Name="PnlGeminiVoiceSettings">
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource CyanPrimaryBrush}" Margin="0,0,0,8" Text="GEMINI ONLINE TTS CONFIGURATION"/>

                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" Text="Dedicated Voice Gemini API Key (Optional override)"/>
                                            <TextBox Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,8" Padding="8,5" x:Name="TxtVoiceOnlineApiKey"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" Text="Gemini TTS Model ID"/>
                                                    <TextBox Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Padding="6,5" Text="gemini-2.5-flash-preview-tts" x:Name="TxtGeminiTtsModel"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" Text="Voice Profile"/>
                                                    <ComboBox FontSize="11.5" Padding="6,4" SelectedIndex="0" x:Name="CmbGeminiVoiceName">
                                                        <ComboBoxItem Content="Kore (Default)" Tag="Kore"/>
                                                        <ComboBoxItem Content="Aoede" Tag="Aoede"/>
                                                        <ComboBoxItem Content="Puck" Tag="Puck"/>
                                                        <ComboBoxItem Content="Charon" Tag="Charon"/>
                                                        <ComboBoxItem Content="Fenrir" Tag="Fenrir"/>
                                                        <ComboBoxItem Content="Leda" Tag="Leda"/>
                                                        <ComboBoxItem Content="Orus" Tag="Orus"/>
                                                        <ComboBoxItem Content="Zephyr" Tag="Zephyr"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL B: GOOYA LOCAL GPU TTS SETTINGS -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Padding="12" Visibility="Collapsed" x:Name="PnlGooyaVoiceSettings">
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" Margin="0,0,0,8" Text="GOOYA BOZORG v1.5 LOCAL ENGINE (SDPA + AMPERE)"/>

                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" Text="Speaker Reference Audio (.wav prompt)"/>
                                            <DockPanel Margin="0,0,0,10">
                                                <Button Click="BtnBrowseGooyaRef_Click" Content="BROWSE" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Style="{StaticResource HoloButtonStyle}"/>
                                                <TextBox Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Padding="6,5" Text="Data/Models/gooya/speaker_reference.wav" x:Name="TxtGooyaRefAudio"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="Exaggeration (Emotion &amp; Pitch Variance)"/>
                                                <TextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" HorizontalAlignment="Right" Text="0.50" x:Name="LblGooyaExagVal"/>
                                            </DockPanel>
                                            <Slider IsSnapToTickEnabled="True" Margin="0,0,0,10" Maximum="1.0" Minimum="0.0" TickFrequency="0.05" Value="0.50" ValueChanged="VoiceSlider_ValueChanged" x:Name="SldGooyaExaggeration"/>

                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="CFG Weight (Flow-Matching Fidelity)"/>
                                                <TextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" HorizontalAlignment="Right" Text="0.50" x:Name="LblGooyaCfgVal"/>
                                            </DockPanel>
                                            <Slider IsSnapToTickEnabled="True" Margin="0,0,0,10" Maximum="1.0" Minimum="0.0" TickFrequency="0.05" Value="0.50" ValueChanged="VoiceSlider_ValueChanged" x:Name="SldGooyaCfgWeight"/>

                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" Text="VRAM Precision &amp; Memory Policy"/>
                                            <ComboBox FontSize="11.5" Margin="0,0,0,8" Padding="6,4" SelectedIndex="0" x:Name="CmbGooyaPrecision">
                                                <ComboBoxItem Content="BFloat16 Mixed Precision (~1.6 GB VRAM - Recommended)" Tag="bf16"/>
                                                <ComboBoxItem Content="Float32 Full Precision (~3.2 GB VRAM)" Tag="fp32"/>
                                            </ComboBox>

                                            <CheckBox Content="Auto-Unload Gooya from VRAM after speech (Max VRAM for Gemma-4)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" x:Name="ChkGooyaAutoUnload"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CYBER-ICE VOCAL DSP MASTERING CHAIN -->
                                    <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" Margin="0,4,0,6" Text="CYBER-ICE VOCAL MASTERING CHAIN (DSP)"/>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="Pitch Shift (Semitones)"/>
                                                <TextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" HorizontalAlignment="Right" Text="-0.3" x:Name="LblPitchVal"/>
                                            </DockPanel>
                                            <Slider IsSnapToTickEnabled="True" Maximum="2.0" Minimum="-4.0" TickFrequency="0.1" Value="-0.3" ValueChanged="VoiceSlider_ValueChanged" x:Name="SldPitch"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="Crystal Presence &amp; Air Mix"/>
                                                <TextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" HorizontalAlignment="Right" Text="0.00" x:Name="LblMetallicVal"/>
                                            </DockPanel>
                                            <Slider IsSnapToTickEnabled="True" Maximum="0.50" Minimum="0.0" TickFrequency="0.02" Value="0.00" ValueChanged="VoiceSlider_ValueChanged" x:Name="SldMetallic"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="Tight Studio Room Reverb"/>
                                                <TextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource CyanSecondaryBrush}" HorizontalAlignment="Right" Text="0.00" x:Name="LblReverbVal"/>
                                            </DockPanel>
                                            <Slider IsSnapToTickEnabled="True" Maximum="0.50" Minimum="0.0" TickFrequency="0.02" Value="0.00" ValueChanged="VoiceSlider_ValueChanged" x:Name="SldReverb"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="Wake-Word Sensitivity"/>
                                                <TextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource CyanPrimaryBrush}" HorizontalAlignment="Right" Text="0.50" x:Name="LblWakeVal"/>
                                            </DockPanel>
                                            <Slider IsSnapToTickEnabled="True" Maximum="0.90" Minimum="0.15" TickFrequency="0.05" Value="0.50" ValueChanged="VoiceSlider_ValueChanged" x:Name="SldWakeThreshold"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Click="BtnApplyVoiceConfig_Click" Content="APPLY VOICE &amp; ENGINE CONFIGURATION" Margin="0,0,0,8" Style="{StaticResource HoloButtonStyle}"/>
                                    <Button Click="BtnTestVoice_Click" Content="🔊  TEST CELESTE VOICE SYNTHESIS" Style="{StaticResource HoloSuccessButtonStyle}"/>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource CyanSecondaryBrush}" Margin="0,10,0,0" Text="" TextWrapping="Wrap" x:Name="TxtVoiceConfigResult"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: MEMORY & FACTS -->
                        <TabItem Header="MEMORY">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="PERSISTENT FACTS MATRIX (SQLite)" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="↻ REFRESH" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Padding="12,4" Click="BtnRefreshFacts_Click"/>
                                </DockPanel>

                                <DataGrid x:Name="GridFacts" Grid.Row="1" AutoGenerateColumns="False" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="42"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="75"/>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="105"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTextColumn Header="Imp" Binding="{Binding Importance}" Width="45"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtFactCategory" Grid.Column="0" Style="{StaticResource HoloTextBoxStyle}" Text="user" Margin="0,0,6,0" ToolTip="Category"/>
                                            <TextBox x:Name="TxtFactKey" Grid.Column="1" Style="{StaticResource HoloTextBoxStyle}" Text="" Margin="0,0,6,0" ToolTip="Fact Key"/>
                                            <TextBox x:Name="TxtFactImportance" Grid.Column="2" Style="{StaticResource HoloTextBoxStyle}" Text="5" ToolTip="Importance (1-10)"/>
                                        </Grid>
                                        <TextBox x:Name="TxtFactValue" Style="{StaticResource HoloTextBoxStyle}" FlowDirection="RightToLeft" Margin="0,0,0,8" ToolTip="Fact Value"/>
                                        <Button Content="＋  SAVE FACT TO MEMORY" Style="{StaticResource HoloSuccessButtonStyle}" Click="BtnAddFact_Click"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="DELETE FACT" Style="{StaticResource HoloDangerButtonStyle}" Margin="0,0,5,0" Click="BtnDeleteFact_Click"/>
                                    <Button Grid.Column="1" Content="CLEAR HISTORY" Style="{StaticResource HoloDangerButtonStyle}" Margin="5,0,0,0" Click="BtnClearHistory_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: HYBRID CLOUD AI & GOOGLE WEB SEARCH CONFIG -->
                        <TabItem Header="API &amp; WEB">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,6,4">
                                <StackPanel>
                                    <TextBlock Text="HYBRID CLOUD AI &amp; WEB SEARCH ROUTER" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Local Qwen 3.5 9B handles daily tasks; Gemini, Claude &amp; ChatGPT activate on demand."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- Router & Proxy Card -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Cloud AI Router Enabled" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="ChkCloudEnabled" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Default Cloud Engine:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="CmbCloudProvider" Grid.Column="1" SelectedIndex="0">
                                                    <ComboBoxItem Content="gemini"/>
                                                    <ComboBoxItem Content="claude"/>
                                                    <ComboBoxItem Content="openai"/>
                                                    <ComboBoxItem Content="local"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="HTTP / SOCKS5 Proxy URL (Optional for API &amp; Search):" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtProxyUrl" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11.5" ToolTip="e.g. http://127.0.0.1:10809"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Gemini API Card -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="GOOGLE GEMINI API" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6"/>
                                            <TextBlock Text="API Key:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtGeminiKey" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBlock Text="Model Name:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtGeminiModel" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Text="gemini-2.5-flash"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Claude API Card -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="ANTHROPIC CLAUDE API" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6"/>
                                            <TextBlock Text="API Key:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtClaudeKey" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBlock Text="Model Name:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtClaudeModel" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Text="claude-3-7-sonnet-latest"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- OpenAI API Card -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="OPENAI CHATGPT API" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6"/>
                                            <TextBlock Text="API Key:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtOpenAiKey" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBlock Text="Model Name:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtOpenAiModel" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Text="gpt-4o"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Google & Web Search Card -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="GOOGLE &amp; LIVE WEB SEARCH" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,4"/>
                                            <TextBlock Text="Works zero-key out-of-the-box; add Serper or Google CSE keys for enhanced ranking."
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock Text="Serper.dev Google API Key (Optional):" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtSerperKey" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Google CSE Key:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="TxtGoogleCseKey" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Google CX ID:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="TxtGoogleCx" Style="{StaticResource HoloTextBoxStyle}" FontFamily="Consolas" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="💾  SAVE API &amp; WEB CONFIGURATION" Style="{StaticResource HoloSuccessButtonStyle}" Margin="0,0,0,8" Click="BtnSaveCloudConfig_Click"/>
                                    <Button Content="🌐  TEST LIVE GOOGLE SEARCH" Style="{StaticResource HoloButtonStyle}" Click="BtnTestWebSearch_Click"/>
                                    <TextBlock x:Name="TxtCloudConfigResult" Text="" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: SECURITY & STARTUP -->
                        <TabItem Header="SECURITY">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WINDOWS LOGON AUTO-START" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="TxtStartupState" Text="Checking registry..." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleStartup" Content="ENABLE" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Width="115" Click="BtnToggleStartup_Click"/>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="SUBSYSTEM DIAGNOSTICS" Foreground="{DynamicResource CyanSecondaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="RUN CHECK" Style="{StaticResource HoloSuccessButtonStyle}" HorizontalAlignment="Right" Padding="12,4" Click="BtnRunDiagnostics_Click"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtDiagnosticsOutput" Text="Ready to verify C.E.L.E.S.T.E. subsystems." Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                    <TextBlock Text="SECURITY AUDIT LOG" Foreground="{DynamicResource CyanPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="↻ REFRESH" Style="{StaticResource HoloButtonStyle}" HorizontalAlignment="Right" Padding="12,4" Click="BtnRefreshAudit_Click"/>
                                </DockPanel>

                                <DataGrid x:Name="GridSecurityAudit" Grid.Row="3" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                        <DataGridTextColumn Header="Command" Binding="{Binding CommandType}" Width="115"/>
                                        <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="75"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 5: LIVE UNIFIED LOGS -->
                        <TabItem Header="LOGS">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Severity + Module + Live Stream Toggles -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="CmbLogSeverity" Grid.Column="0" SelectedIndex="0" SelectionChanged="CmbLogSeverity_SelectionChanged" ToolTip="Filter by severity level">
                                        <ComboBoxItem Content="ALL"/>
                                        <ComboBoxItem Content="DEBUG"/>
                                        <ComboBoxItem Content="INFO"/>
                                        <ComboBoxItem Content="WARNING"/>
                                        <ComboBoxItem Content="ERROR"/>
                                        <ComboBoxItem Content="CRITICAL"/>
                                    </ComboBox>

                                    <ComboBox x:Name="CmbLogModule" Grid.Column="2" SelectedIndex="0" SelectionChanged="CmbLogModule_SelectionChanged" ToolTip="Filter by backend module">
                                        <ComboBoxItem Content="ALL"/>
                                    </ComboBox>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <CheckBox x:Name="ChkLogLive" Content="LIVE" IsChecked="True" Foreground="{DynamicResource CyanSecondaryBrush}"
                                                  FontSize="10.5" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Checked="ChkLogLive_Changed" Unchecked="ChkLogLive_Changed"
                                                  ToolTip="Receive live logs over /ws/desktop"/>
                                        <CheckBox x:Name="ChkLogAutoScroll" Content="TAIL" IsChecked="True" Foreground="{DynamicResource TextMutedBrush}"
                                                  FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"
                                                  ToolTip="Auto-scroll to newest log entry"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Search Box + Refresh / Copy / Clear -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtLogSearch" Grid.Column="0" Style="{StaticResource HoloTextBoxStyle}"
                                             FontFamily="Consolas" FontSize="11" Padding="7,4"
                                             TextChanged="TxtLogSearch_TextChanged"
                                             ToolTip="Search message, module, turn_id (e.g. REST-xxxx / WS-xxxx), or traceback"/>

                                    <Button Grid.Column="1" Content="↻" Style="{StaticResource HoloButtonStyle}" Margin="6,0,0,0" Padding="9,4"
                                            Click="BtnRefreshLogs_Click" ToolTip="Reload unified logs from backend ring buffer"/>
                                    <Button Grid.Column="2" Content="COPY" Style="{StaticResource HoloButtonStyle}" Margin="4,0,0,0" Padding="8,4"
                                            Click="BtnCopyLogs_Click" ToolTip="Copy selected log (or all visible logs) with tracebacks"/>
                                    <Button Grid.Column="3" Content="CLR" Style="{StaticResource HoloDangerButtonStyle}" Margin="4,0,0,0" Padding="8,4"
                                            Click="BtnClearLogsView_Click" ToolTip="Clear local log view &amp; search"/>
                                </Grid>

                                <!-- Row 2: Rich Color-Coded Structured Log Stream -->
                                <Border Grid.Row="2" Background="{DynamicResource GridBgBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <ListBox x:Name="LstLogs" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="10.8"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             MouseDoubleClick="LstLogs_MouseDoubleClick">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Selected Entry (+ Traceback)" Click="MenuCopySelectedLog_Click"/>
                                                <MenuItem Header="Filter by Turn ID" Click="MenuFilterTurn_Click"/>
                                                <MenuItem Header="Copy All Visible Logs" Click="BtnCopyLogs_Click"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{Binding LevelBrush}" BorderThickness="3,0,0,0"
                                                        CornerRadius="5" Padding="7,5" Margin="2,0,2,4">
                                                    <StackPanel>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding ShortTimestamp}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <Border Background="{Binding LevelBadgeBg}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontSize="9.5" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding ModuleTag}" Foreground="{DynamicResource CyanPrimaryBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <Border Visibility="{Binding TurnVisibility}" Background="{DynamicResource BgSubtlePillBrush}"
                                                                    BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TurnId}" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11"/>
                                                        <Border Visibility="{Binding TracebackVisibility}" Background="#1AF43F5E" BorderBrush="#66F43F5E"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Traceback}" Foreground="#FDA4AF" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Row 3: Live Counter Footer -->
                                <DockPanel Grid.Row="3" Margin="2,6,2,0">
                                    <TextBlock x:Name="TxtLogCount" Text="0 entries" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="Double-click entry to filter its Turn ID" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8"/>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Right Edge Floating Pill Handle -->
            <Button x:Name="BtnRightHandle" Content="CONTROL DECK   ❮" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,20,0" Style="{StaticResource HoloButtonStyle}" Padding="14,12"
                    Click="BtnToggleRightDrawer_Click"/>

            <!-- 3C. BOTTOM SLIDE-OUT DRAWER: PERSIAN DIALOGUE & COMMAND INPUT -->
            <Border x:Name="BottomDrawer" Visibility="Collapsed" Height="370" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Width="1040" Margin="0,0,0,14" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="20,16">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BottomDrawerTransform" Y="400"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource CyanSecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="C.E.L.E.S.T.E. DIALOGUE STREAM  //  ترمینال گفتگوی تاکتیکی"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource BgSubtlePillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChatStatus" Text="ONLINE" Foreground="{DynamicResource CyanSecondaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                            <Button Content="▼  HIDE" Style="{StaticResource HoloButtonStyle}" Padding="12,4" Click="BtnToggleBottomDrawer_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource GridBgBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                        <ListBox x:Name="LstConversation" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" FlowDirection="LeftToRight" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0,2,10">
                                        <Border x:Name="BubbleBorder"
                                                HorizontalAlignment="{Binding BubbleAlignment}"
                                                MaxWidth="720"
                                                MinWidth="210"
                                                Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource CyanPrimaryBrush}"
                                                BorderThickness="{Binding AccentBorderThickness}"
                                                CornerRadius="12"
                                                Padding="14,10">
                                            <StackPanel>
                                                <DockPanel FlowDirection="LeftToRight" Margin="0,0,0,5" LastChildFill="False">
                                                    <TextBlock x:Name="TxtBubbleSender"
                                                               DockPanel.Dock="Left"
                                                               Text="{Binding DisplaySender}"
                                                               Foreground="{DynamicResource CyanSecondaryBrush}"
                                                               FontWeight="Bold"
                                                               FontSize="11"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding ShortTimestamp}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Margin="14,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           FlowDirection="RightToLeft"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13.5"
                                                           LineHeight="22"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource UserBubbleBgBrush}"/>
                                            <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource CyanSecondaryBrush}"/>
                                            <Setter TargetName="TxtBubbleSender" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtChatInput" Grid.Column="0" Style="{StaticResource HoloTextBoxStyle}"
                                 FlowDirection="RightToLeft" FontSize="13.5" KeyDown="TxtChatInput_KeyDown"/>
                        <Button Grid.Column="1" Content="ارسال فرمان  ➤" Style="{StaticResource HoloSuccessButtonStyle}" Margin="10,0,0,0" Click="BtnSendChat_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom Edge Floating Dock + Status Ticker -->
            <Grid x:Name="BottomDockBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="24,0,24,16" IsHitTestVisible="True">
                <Border Background="{DynamicResource BgDockPillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusBar" Text="C.E.L.E.S.T.E. Cyber-Ice Core Initialized"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <Button x:Name="BtnBottomHandle" Content="▲   DIALOGUE &amp; COMMAND TERMINAL"
                        HorizontalAlignment="Center" Style="{StaticResource HoloButtonStyle}" Padding="24,8"
                        Click="BtnToggleBottomDrawer_Click"/>

                <Border Background="{DynamicResource BgDockPillBrush}" BorderBrush="{DynamicResource CyanBorderDimBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtClock" Text="00:00:00" Foreground="{DynamicResource CyanSecondaryBrush}"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="12.5"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>